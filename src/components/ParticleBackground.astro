---
/**
 * ParticleBackground.astro
 * WebGPU N-body dual-galaxy merger background.
 */
---

<canvas
  id="galaxy-canvas"
  class="fixed inset-0 z-0 pointer-events-none"
  aria-hidden="true"></canvas>

<script>
  import { initGalaxyEngine } from "../../vendor/webgpu-galaxy-merger/src/galaxyEngine";
  import {
    getActiveTheme,
    THEME_CHANGE_EVENT,
    type ThemeName,
  } from "../scripts/themeController";

  let cleanup: (() => void) | undefined;

  const syncBackground = (theme: ThemeName) =>
    window.dispatchEvent(
      new CustomEvent("galaxy:visibility", {
        detail: { visible: theme === "galaxy" },
      }),
    );

  const onThemeChange = (event: Event) =>
    syncBackground((event as CustomEvent<{ theme: ThemeName }>).detail.theme);

  const initBackground = () => {
    window.removeEventListener(THEME_CHANGE_EVENT, onThemeChange);
    window.addEventListener(THEME_CHANGE_EVENT, onThemeChange);
    if (!cleanup) cleanup = initGalaxyEngine();
    syncBackground(getActiveTheme());
  };

  document.addEventListener("DOMContentLoaded", initBackground);
  document.addEventListener("astro:page-load", initBackground);
  
  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener(THEME_CHANGE_EVENT, onThemeChange);
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  #galaxy-canvas {
    background: transparent;
  }
</style>
