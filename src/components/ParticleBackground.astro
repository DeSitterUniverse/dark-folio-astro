---
/**
 * ParticleBackground.astro
 * True N-Body Dual Galaxy Merger.
 * Features: Dynamical Friction, Inelastic Core Mergers, and Softened Gravity.
 */
---

<canvas
  id="galaxy-canvas"
  class="fixed inset-0 z-0 pointer-events-none"
  aria-hidden="true"></canvas>

<script>
  import { initGalaxyEngine } from "../scripts/galaxyEngine";

  let cleanup: (() => void) | undefined;
  
  document.addEventListener("DOMContentLoaded", () => {
    cleanup = initGalaxyEngine();
  });
  
  document.addEventListener("astro:page-load", () => {
    if (cleanup) cleanup();
    cleanup = initGalaxyEngine();
  });
  
  document.addEventListener("astro:before-swap", () => {
    if (cleanup) cleanup();
  });
</script>

<style>
  #galaxy-canvas {
    background: transparent;
  }
</style>
