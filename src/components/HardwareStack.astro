---
/**
 * HardwareStack.astro
 * Skills section displayed as categorized lists instead of full-width tiles.
 * Compact, scannable layout divided into logical sections.
 */
import { skillCategories } from "../data/skills";
---

<section id="stack" class="relative py-20 sm:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section header -->
    <div class="mb-14">
      <h2 class="font-mono text-sm text-text-muted tracking-widest uppercase mb-3">
        // tech_stack
      </h2>
      <p class="text-2xl sm:text-3xl font-mono font-semibold text-text-primary">
        Tools & Technologies
      </p>
      <div class="mt-4 w-16 h-px bg-accent/40"></div>
    </div>

    <!-- Skills grid: 2-3 columns of categorized lists -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
      {skillCategories.map((category) => (
        <div>
          <h3 class="font-mono text-xs font-semibold text-accent tracking-widest uppercase mb-4 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
            {category.title}
          </h3>
          <ul class="space-y-2">
            {category.items.map((item) => (
              <li class="text-sm text-text-secondary flex items-center gap-2.5 group">
                <span class="w-1 h-1 rounded-full bg-border shrink-0 group-hover:bg-accent transition-colors duration-200"></span>
                <span class="group-hover:text-text-primary transition-colors duration-200">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
