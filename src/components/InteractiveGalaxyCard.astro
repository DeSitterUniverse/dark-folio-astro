---
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";
import PlayLight from "phosphor-astro/PlayLight.astro";
import PauseLight from "phosphor-astro/PauseLight.astro";

const description = 'A real-time galaxy merger simulation built with WebGPU, WGSL, TypeScript, and Astro. Each galaxy contains a live stellar disk, dark-matter halo, and compact core, allowing the whole system to exchange energy and angular momentum as the encounter develops. Leapfrog integration and selectable all-pairs or Barnes-Hut gravity support stable evolution across a wide range of particle counts.<br><br>The simulation follows a bound, inclined encounter from first approach through core coalescence and remnant formation. Live disks and halos respond collectively as energy and angular momentum move through the system, producing tidal bridges, extended tails, halo wakes, and a disturbed three-dimensional remnant. Seeded initial conditions keep comparisons repeatable while the controls vary particle resolution, disk scale, and starting separation.';
---

<article class="project-row galaxy-project" data-galaxy-project>
  <div class="project-heading">
    <h3>GPGPU N-Body Galaxy Merger</h3>
    <p>Astro · WebGPU · WGSL · TypeScript</p>
  </div>
  <div class="project-body">
    <details class="editorial-details project-description">
      <summary>Description</summary>
      <p set:html={description}></p>
    </details>

    <button type="button" class="galaxy-theme-toggle" data-galaxy-theme-toggle data-action="on">Turn on</button>

    <div class="galaxy-settings" data-galaxy-settings>
      <div class="setting-row">
        <span>Simulation State</span>
        <button id="galaxy-pause-btn" data-galaxy-control aria-label="Toggle Pause">
          <span id="icon-pause"><PauseLight /></span>
          <span id="icon-play" class="hidden"><PlayLight /></span>
        </button>
      </div>
      <fieldset class="galaxy-solver-selector" aria-label="Gravity solver">
        <legend>Gravity Solver</legend>
        <button type="button" data-galaxy-control data-galaxy-solver="all-pairs" aria-pressed="true">All-Pairs</button>
        <button type="button" data-galaxy-control data-galaxy-solver="barnes-hut" aria-pressed="false">Barnes-Hut</button>
      </fieldset>
      <output id="galaxy-backend-status" class="galaxy-runtime-status" aria-live="polite" hidden>Idle</output>
      <label>Particle Count (Grid Size) <output id="galaxy-stars-value">72x72</output>
        <input type="range" id="galaxy-stars-slider" data-galaxy-control min="56" max="160" step="8" value="72" />
      </label>
      <label>Disk Radius <output id="galaxy-radius-value">35</output>
        <input type="range" id="galaxy-radius-slider" data-galaxy-control min="15" max="80" step="1" value="35" />
      </label>
      <label>Initial Center Offset <output id="galaxy-offset-value">25</output>
        <input type="range" id="galaxy-offset-slider" data-galaxy-control min="10" max="60" step="1" value="25" />
      </label>
      <dl class="galaxy-diagnostics" aria-label="Live merger statistics">
        <div><dt>Simulation Time</dt><dd><output id="galaxy-time-value">0.00</output></dd></div>
        <div><dt>Core Separation</dt><dd><output id="galaxy-core-separation-value">—</output></dd></div>
      </dl>
    </div>

    <a class="source-link" href="https://github.com/DeSitterUniverse/webgpu-galaxy-merger" target="_blank" rel="noopener noreferrer">
      <GithubLogoLight /> Source
    </a>
  </div>
</article>

<script>
  import { initGalaxyControls, setGalaxyPaused } from "../../vendor/webgpu-galaxy-merger/src/galaxyControls";
  import { applyTheme, getActiveTheme, THEME_CHANGE_EVENT, type ThemeName } from "../scripts/themeController";

  const syncGalaxyProject = (theme: ThemeName) => {
    const enabled = theme === "galaxy";
    document.querySelectorAll<HTMLInputElement | HTMLButtonElement>("[data-galaxy-control]").forEach((control) => {
      control.disabled = !enabled;
    });
    document.querySelector<HTMLElement>("[data-galaxy-project]")?.setAttribute("data-live", String(enabled));
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-galaxy-theme-toggle]");
    if (themeToggle) {
      themeToggle.textContent = enabled ? "Turn off" : "Turn on";
      themeToggle.dataset.action = enabled ? "off" : "on";
    }
    if (enabled) setGalaxyPaused(false);
  };

  const onThemeChange = (event: Event) =>
    syncGalaxyProject((event as CustomEvent<{ theme: ThemeName }>).detail.theme);

  const init = () => {
    initGalaxyControls();
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-galaxy-theme-toggle]");
    if (themeToggle && !themeToggle.dataset.loaded) {
      themeToggle.dataset.loaded = "true";
      themeToggle.addEventListener("click", () => {
        const darkSelected =
          getActiveTheme() === "dark" ||
          document.documentElement.dataset.pendingTheme === "dark";
        applyTheme(darkSelected ? "galaxy" : "dark");
      });
    }
    window.removeEventListener(THEME_CHANGE_EVENT, onThemeChange);
    window.addEventListener(THEME_CHANGE_EVENT, onThemeChange);
    syncGalaxyProject(getActiveTheme());
  };

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => window.removeEventListener(THEME_CHANGE_EVENT, onThemeChange));
</script>
