---
/**
 * Connect.astro
 * Minimal footer/contact section with icon links.
 * Includes Github, LinkedIn, Email, and Resume download.
 */
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";
import LinkedinLogoLight from "phosphor-astro/LinkedinLogoLight.astro";
import FilePdfLight from "phosphor-astro/FilePdfLight.astro";

const links = [
  {
    label: "Github",
    href: "https://github.com/DeSitterUniverse",
    icon: "github",
    external: true,
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/skye-ibrahim",
    icon: "linkedin",
    external: true,
  },

  {
    label: "Resume",
    href: "/0010resume.pdf",
    icon: "resume",
    external: true,
  },
];
---

<footer id="connect" class="relative py-20 sm:py-28 border-t border-border-dim">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <!-- Section header -->
    <h2 class="font-mono text-sm text-text-muted tracking-widest uppercase mb-3">
      // connect
    </h2>
    <p class="text-xl sm:text-2xl font-mono font-semibold text-text-primary mb-10">
      Let's Build Something
    </p>

    <!-- Link row -->
    <div class="flex flex-wrap items-center justify-center gap-3">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          id={`connect-${link.icon}`}
          class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border-dim bg-surface-card/30 text-text-secondary font-mono text-sm tracking-wide transition-all duration-300 hover:border-accent hover:text-accent hover:bg-accent-dim"
        >
          {link.icon === "github" && <GithubLogoLight class="w-4 h-4" />}
          {link.icon === "linkedin" && <LinkedinLogoLight class="w-4 h-4" />}

          {link.icon === "resume" && <FilePdfLight class="w-4 h-4" />}
          {link.label}
        </a>
      ))}
    </div>

    <!-- Copyright -->
    <p class="mt-16 text-xs text-text-muted/60 font-mono">
      &copy; {new Date().getFullYear()} Skye Ibrahim.
    </p>
  </div>
</footer>
