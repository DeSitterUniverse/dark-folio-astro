---
import type { Project } from "../data/projects";
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";

interface Props { project: Project }
const { project } = Astro.props;
const linkIndex = project.descriptionLink
  ? project.description.indexOf(project.descriptionLink.text)
  : -1;
const before = linkIndex >= 0 ? project.description.slice(0, linkIndex) : project.description;
const after = linkIndex >= 0 && project.descriptionLink
  ? project.description.slice(linkIndex + project.descriptionLink.text.length)
  : "";
---

<article class="project-row">
  <div class="project-heading">
    <h3>{project.title}</h3>
    <p>{project.tech.join(" · ")}</p>
  </div>
  <div class="project-body">
    <details class="editorial-details project-description">
      <summary>Description</summary>
      <p>
        {before}
        {linkIndex >= 0 && project.descriptionLink && (
          <a href={project.descriptionLink.url} target="_blank" rel="noopener noreferrer">{project.descriptionLink.text}</a>
        )}
        {after}
      </p>
    </details>
    <a class="source-link" href={project.github} target="_blank" rel="noopener noreferrer">
      <GithubLogoLight /> Source
    </a>
  </div>
</article>
