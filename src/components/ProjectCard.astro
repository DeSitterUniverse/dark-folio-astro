---
/**
 * ProjectCard.astro
 * Individual project card with 3D proximity glow border effect.
 * Uses a minimal client script to track mouse coords → CSS custom properties.
 * The ::before pseudo-element renders a radial gradient glow that follows the cursor.
 * On hover, inner content lifts via translateZ for extruded depth.
 */
import type { Project } from "../data/projects";
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";
import ArrowSquareOutLight from "phosphor-astro/ArrowSquareOutLight.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const descriptionLinkIndex = project.descriptionLink
  ? project.description.indexOf(project.descriptionLink.text)
  : -1;
const descriptionBeforeLink =
  descriptionLinkIndex >= 0
    ? project.description.slice(0, descriptionLinkIndex)
    : project.description;
const descriptionAfterLink =
  descriptionLinkIndex >= 0 && project.descriptionLink
    ? project.description.slice(
        descriptionLinkIndex + project.descriptionLink.text.length,
      )
    : "";
---

<div class="card-perspective" data-glow-card>
  <!-- Glow border layer (anchored to base) -->
  <div class="glow-card">
    <!-- Inner content (lifts on hover) -->
    <div class="glow-card-content">
      <!-- Project title -->
      <h3 class="font-mono text-lg font-semibold text-text-primary mb-3 tracking-tight">
        {project.title}
      </h3>

      <!-- Description -->
      <p class="text-sm text-text-secondary leading-relaxed mb-5">
        {descriptionBeforeLink}
        {descriptionLinkIndex >= 0 && project.descriptionLink && (
          <a
            href={project.descriptionLink.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline decoration-accent/40 underline-offset-2 transition-colors duration-200 hover:text-accent-bright hover:decoration-accent"
          >{project.descriptionLink.text}</a>
        )}
        {descriptionAfterLink}
      </p>

      <!-- Tech tags -->
      <div class="flex flex-wrap gap-2 mb-5">
        {project.tech.map((tech) => (
          <span class="inline-block px-2.5 py-1 rounded-md text-xs font-mono text-accent bg-accent-dim border border-accent/10">
            {tech}
          </span>
        ))}
      </div>

      <!-- Links -->
      <div class="flex items-center gap-4 mt-auto pt-4 border-t border-border-dim">
        {project.github && project.github !== "#" && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-text-muted font-mono transition-colors duration-200 hover:text-accent"
          >
            <GithubLogoLight class="w-4 h-4" />
            Source
          </a>
        )}
        {project.github === "#" && (
          <span class="inline-flex items-center gap-1.5 text-sm text-text-muted/50 font-mono cursor-not-allowed">
            <GithubLogoLight class="w-4 h-4" />
            Private
          </span>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-text-muted font-mono transition-colors duration-200 hover:text-accent"
          >
            <ArrowSquareOutLight class="w-4 h-4" />
            Live Demo
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  /* ─── 3D Card Wrapper ─── */
  .card-perspective {
    perspective: 1000px;
  }

  /* ─── Glow Card (base layer with border effect) ─── */
  .glow-card {
    position: relative;
    border-radius: 1rem;
    padding: 1px; /* Border thickness */
    background: var(--color-border-dim);
    transition: background 0.4s ease;
    overflow: hidden;
  }

  /* Border color on hover (non-following) */
  .glow-card:hover {
    background: var(--color-accent);
  }

  /* ─── Inner Content (lifts on hover for 3D depth) ─── */
  .glow-card-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    border-radius: calc(1rem - 1px);
    background: var(--color-surface-card);
    padding: 1.5rem;
    min-height: 100%;
    transition: transform 0.4s ease, background 0.4s ease;
    will-change: transform;
    transform: translateZ(0);
  }

  .glow-card:hover .glow-card-content {
    transform: translateZ(16px);
    background: var(--color-surface-hover);
  }
</style>
