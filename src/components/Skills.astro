---
/**
 * Skills.astro
 * Redesigned as a "Technical Spec Sheet" for better scannability and a professional look.
 * Replaces bulky logos with a dense, industrial grid layout.
 */
import { skillCategories } from "../data/skills";
import CubeLight from "phosphor-astro/CubeLight.astro";
---

<section id="stack" class="relative py-20 sm:py-32 border-t border-border-dim/30">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-20">
      <div class="max-w-xl">
        <h2 class="font-mono text-sm text-accent tracking-[0.2em] uppercase mb-4">
          // technical_specifications
        </h2>
        <p class="text-4xl sm:text-5xl font-mono font-bold text-text-primary tracking-tight">
          Tools & Tech<span class="text-accent">_</span>
        </p>
      </div>
      <div class="hidden md:block">
        <!-- Metadata removed as per request -->
      </div>
    </div>

    <!-- The Spec Sheet Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
      {skillCategories.map((category) => (
        <div class="group relative p-8 rounded-2xl bg-surface-card/40 backdrop-blur-md border border-border-dim/50 hover:border-accent/30 transition-all duration-500">
          <!-- Category Header -->
          <div class="flex items-center gap-4 mb-8">
            <div class="w-8 h-8 rounded-lg bg-surface-card border border-border-dim flex items-center justify-center text-accent group-hover:border-accent/40 group-hover:bg-accent-dim transition-all duration-300">
              <CubeLight class="w-4 h-4" />
            </div>
            <h3 class="font-mono text-base font-bold text-text-primary tracking-wide">
              {category.title.toUpperCase()}
            </h3>
            <div class="flex-grow h-px bg-gradient-to-r from-border-dim to-transparent ml-2"></div>
          </div>

          <!-- Skills Row -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-6">
            {category.items.map((item) => (
              <div class="skill-item flex items-center gap-2 group/item">
                <div class="w-1 h-1 rounded-full bg-border-dim group-hover/item:bg-accent group-hover/item:scale-125 transition-all duration-300"></div>
                <span class="font-mono text-[13px] text-text-secondary group-hover/item:text-text-primary transition-colors">
                  {item}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Note -->
    <div class="mt-20 pt-8 border-t border-border-dim/20 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-mono text-[10px] text-text-muted uppercase tracking-[0.3em] mx-auto">
        Technical Competencies & Systems Engineering
      </p>
    </div>
  </div>
</section>

<style>
  .skill-item {
    cursor: default;
  }
</style>
