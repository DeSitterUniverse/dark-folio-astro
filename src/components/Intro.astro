---
/**
 * Intro.astro
 * Hero section with name, typewriter title rotation, about text, and CTA buttons.
 * Typewriter cycles through titles with delete + retype animation.
 */
import ArrowDownLight from "phosphor-astro/ArrowDownLight.astro";
import GithubLogoLight from "phosphor-astro/GithubLogoLight.astro";
import FilePdfLight from "phosphor-astro/FilePdfLight.astro";
---

<section id="about" class="relative min-h-screen flex items-center justify-center pt-14">
  <div id="intro" class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <!-- Name -->
    <h1 class="font-mono text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-none mb-4">
      <span class="text-text-primary">Skye Ibrahim</span>
    </h1>

    <!-- Typewriter title -->
    <div class="h-10 sm:h-12 flex items-center justify-center mb-8">
      <span id="typewriter" class="font-mono text-xl sm:text-2xl md:text-3xl text-accent font-medium"></span>
      <span class="typewriter-cursor font-mono text-xl sm:text-2xl md:text-3xl text-accent">|</span>
    </div>

    <!-- About / Description -->
    <p class="max-w-2xl mx-auto text-base sm:text-lg text-text-secondary font-light leading-relaxed mb-8">
      I'm a full-stack software developer with a strong background in building reliable, data-centric systems that prioritize performance, maintainability, and clarity. My work spans backend development, automation, and data engineering.
    </p>


    <!-- CTA Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#projects"
        id="cta-projects"
        class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border bg-surface-card/50 text-text-primary font-mono text-sm tracking-wide transition-all duration-300 hover:border-accent hover:text-accent hover:bg-accent-dim"
      >
        <ArrowDownLight class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5" />
        View Projects
      </a>

      <a
        href="https://github.com/DeSitterUniverse"
        target="_blank"
        rel="noopener noreferrer"
        id="cta-github"
        class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-border bg-surface-card/50 text-text-primary font-mono text-sm tracking-wide transition-all duration-300 hover:border-accent hover:text-accent hover:bg-accent-dim"
      >
        <GithubLogoLight class="w-4 h-4" />
        Github
      </a>

      <a
        href="/resume.pdf"
        download
        id="cta-resume"
        class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-accent/30 bg-accent-dim text-accent font-mono text-sm tracking-wide transition-all duration-300 hover:border-accent hover:bg-accent/20"
      >
        <FilePdfLight class="w-4 h-4" />
        Resume
      </a>
    </div>
  </div>
</section>

<style>
  /* Blinking cursor animation */
  .typewriter-cursor {
    animation: blink 0.7s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>

<!-- Typewriter effect: cycles through titles with backspace + retype -->
<script>
  const titles = ["Data Engineer", "Full-Stack Developer", "Automation Developer"];
  const el = document.getElementById("typewriter");
  if (!el) throw new Error("Typewriter element not found");

  let titleIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  const TYPE_SPEED = 80;
  const DELETE_SPEED = 40;
  const PAUSE_AFTER_TYPE = 2000;
  const PAUSE_AFTER_DELETE = 400;

  function tick() {
    const current = titles[titleIndex];

    if (!isDeleting) {
      // Typing
      el.textContent = current.slice(0, charIndex + 1);
      charIndex++;

      if (charIndex === current.length) {
        // Finished typing — pause then start deleting
        isDeleting = true;
        setTimeout(tick, PAUSE_AFTER_TYPE);
        return;
      }
      setTimeout(tick, TYPE_SPEED);
    } else {
      // Deleting
      el.textContent = current.slice(0, charIndex - 1);
      charIndex--;

      if (charIndex === 0) {
        // Finished deleting — move to next title
        isDeleting = false;
        titleIndex = (titleIndex + 1) % titles.length;
        setTimeout(tick, PAUSE_AFTER_DELETE);
        return;
      }
      setTimeout(tick, DELETE_SPEED);
    }
  }

  tick();
</script>
