        details: [
          "Developed ETL pipelines in ADF using Python/Java, processing 300+ entries daily with a 35% efficiency boost.",
          "Managed Change Data Capture (CDC) via Qlik across Azure Synapse and SQL Server.",
          "Resolved 96% of production incidents within SLA using ServiceNow.",
          "Documented 200+ ETL processes in Informatica Cloud and ADF.",
          "Developed and maintained dashboards to provide stakeholders with real-time visibility into ETL process performance and status",
        ],
      },
      {
        title: "Software Engineer",
        team: "Intelligent Automation Team",
        description: "Engineered intelligent automation solutions and standardized libraries in an Agile environment, significantly increasing process reliability and reducing manual effort.",
        details: [
          "Re-designed transactional automation processes, increasing success rates from 30% to 96% and saving 800+ manual hours.",
          "Developed standardized libraries for metric tracking with 99%+ reliability.",
          "Managed user roles and configuration as a UiPath Administrator.",
          "Implemented RPA documentation standards across the enterprise.",
          "Developed attended and terminal automations using UiPath, C#, .NET and Python; 800+ hours saved",
        ],
      },
      {
        title: "RPA Developer",
        team: "eRPA Enterprise",
        description: "Deployed scalable enterprise RPA solutions using Agile methodologies to streamline workflows, execute large-scale migrations, and track ROI.",
        details: [
          "Designed and developed enterprise automations saving 2,900+ manual hours.",
          "Maintained system compatibility and high success rates during 100,000+ entry migrations.",
          "Visualized ROI metrics using Kibana dashboards and Elasticsearch.",
          "Resolved critical errors to ensure process integrity during system updates.",
          "Managed the end-to-end stakeholder lifecycle for RPA initiatives, translating complex business requirements from senior management into technical specifications while providing regular progress reports and ROI analysis.",
        ],
      },
